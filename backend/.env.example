# Application Settings
APP_NAME="Hierarchy & Buying-Role Classification Agent"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# LLM Configuration
# Supported providers: mock, openai, google_genai, anthropic, groq, ollama
LLM_PROVIDER=groq

# Groq model
LLM_MODEL=openai/gpt-oss-20b

# Your Groq API key
LLM_API_KEY=your_groq_api_key_here

# Groq OpenAI-compatible API endpoint
LLM_BASE_URL=https://api.groq.com/openai/v1

# Deterministic classification
LLM_TEMPERATURE=0.0

# Graph Execution Settings
MAX_RETRIES=2
GRAPH_TIMEOUT_SECONDS=60